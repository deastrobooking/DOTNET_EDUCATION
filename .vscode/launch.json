{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch ASP.NET Web Forms",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "iisexpress",
            "program": "${workspaceFolder}/bin/Debug/HW4.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "http://localhost:52061/LogIn.aspx"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "Attach to IIS Express",
            "type": "clr",
            "request": "attach",
            "processName": "iisexpress"
        }
    ]
}